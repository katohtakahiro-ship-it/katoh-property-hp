---
import { render } from 'astro:content';
import Post from '../../../layouts/Post.astro';
import { getPosts, postSlug, getAlternatePath } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts('en');
  return Promise.all(
    posts.map(async (post) => ({
      params: { slug: postSlug(post) },
      props: { post, alternate: await getAlternatePath(post) },
    })),
  );
}

const { post, alternate } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, tags, faq } = post.data;
---

<Post locale="en" alternate={alternate} title={title} description={description} date={date} updated={updated} tags={tags} faq={faq}>
  <Content />
</Post>
