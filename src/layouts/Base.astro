---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE, siteFor } from '../config/site';
import { HTML_LANG, OG_LOCALE, otherLocale, type Locale } from '../i18n';

interface Props {
  /** ページタイトル。省略時はサイト名のみ */
  title?: string;
  description?: string;
  /** og:type。記事ページは 'article' */
  ogType?: 'website' | 'article';
  /** ページ固有の JSON-LD（Organization に追加して出力） */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** ページの言語（既定は日本語） */
  locale?: Locale;
  /** 対になる言語のページのパス。無い場合は省略（hreflang と言語切替に使う） */
  alternate?: string | null;
}

const { title, ogType = 'website', jsonLd, locale = 'ja', alternate = null } = Astro.props;

const site = siteFor(locale);
const other = otherLocale(locale);
const otherSite = siteFor(other);
const description = Astro.props.description ?? site.description;

const fullTitle = title ? `${title} | ${site.shortName}` : site.defaultTitle;
const siteUrl = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const alternateUrl = alternate ? new URL(alternate, siteUrl).href : null;
const orgId = new URL('/#organization', siteUrl).href;
const personId = new URL('/#representative', siteUrl).href;

/** hreflang: 自分 + 対訳。x-default は日本語ページ */
const hreflangs: { lang: string; href: string }[] = [{ lang: HTML_LANG[locale], href: canonical }];
if (alternateUrl) hreflangs.push({ lang: HTML_LANG[other], href: alternateUrl });
const xDefault = locale === 'ja' ? canonical : alternateUrl;

const ja = locale === 'ja';
const joinAreas = (list: readonly string[]) => list.join(ja ? '・' : ', ');

/** 全ページ共通: Organization / RealEstateAgent（免許番号・住所を含む）。@id は言語で共通 */
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': ['RealEstateAgent', 'Organization'],
  '@id': orgId,
  name: site.name,
  legalName: SITE.name,
  alternateName: [site.shortName, otherSite.name],
  url: siteUrl.href,
  description: site.description,
  address: {
    '@type': 'PostalAddress',
    postalCode: site.address.postalCode,
    addressRegion: site.address.region,
    addressLocality: site.address.locality,
    streetAddress: site.address.street,
    addressCountry: 'JP',
  },
  areaServed: site.areaServed.map((name) => ({ '@type': 'AdministrativeArea', name })),
  identifier: {
    '@type': 'PropertyValue',
    name: ja ? '宅地建物取引業免許番号' : 'Real estate brokerage license number',
    value: site.licenseNumber,
  },
  founder: site.representatives.map((name) => ({ '@type': 'Person', name })),
  employee: { '@id': personId },
  knowsAbout: site.knowsAbout,
  knowsLanguage: ['ja', 'en'],
  makesOffer: [
    {
      '@type': 'Offer',
      name: ja ? '売買仲介' : 'Sales brokerage',
      description: `${ja ? '仲介手数料' : 'Brokerage fee'}: ${site.fees.sale}（${site.fees.saleNote}）`,
      areaServed: joinAreas(site.areaServed),
    },
    {
      '@type': 'Offer',
      name: ja ? '賃貸仲介' : 'Rental brokerage',
      description: `${ja ? '仲介手数料' : 'Brokerage fee'}: ${site.fees.rent}`,
      areaServed: joinAreas(site.areaServed),
    },
  ],
};

/** 代表の一人（加藤隆寛）。YouTube を sameAs で紐づける */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': personId,
  name: site.representative.name,
  alternateName: otherSite.representative.name,
  jobTitle: site.representative.title,
  description: site.representative.bio,
  worksFor: { '@id': orgId },
  homeLocation: { '@type': 'Place', name: ja ? '神奈川県川崎市' : 'Kawasaki, Kanagawa, Japan' },
  sameAs: [site.representative.youtube.url],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', siteUrl).href,
  url: siteUrl.href,
  name: site.name,
  inLanguage: ['ja', 'en'],
  publisher: { '@id': orgId },
};
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hreflangs.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {alternateUrl && <meta property="og:locale:alternate" content={OG_LOCALE[other]} />}
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400;600&family=Shippori+Mincho:wght@400;600;800&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&display=swap"
      rel="stylesheet"
    />

    <JsonLd data={organizationSchema} />
    <JsonLd data={websiteSchema} />
    <JsonLd data={personSchema} />
    {jsonLd && <JsonLd data={jsonLd} />}
    <slot name="head" />
  </head>
  <body>
    <Header locale={locale} alternate={alternate} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
