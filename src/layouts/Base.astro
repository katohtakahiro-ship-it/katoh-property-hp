---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE } from '../config/site';

interface Props {
  /** ページタイトル。省略時はサイト名のみ */
  title?: string;
  description?: string;
  /** og:type。記事ページは 'article' */
  ogType?: 'website' | 'article';
  /** ページ固有の JSON-LD（Organization に追加して出力） */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE.shortName}` : `${SITE.name} | 仲介手数料 売買1%・賃貸半額｜武蔵小杉・川崎・横浜`;
const siteUrl = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const orgId = new URL('/#organization', siteUrl).href;

/** 全ページ共通: Organization / RealEstateAgent（免許番号・住所を含む） */
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': ['RealEstateAgent', 'Organization'],
  '@id': orgId,
  name: SITE.name,
  legalName: SITE.name,
  alternateName: SITE.shortName,
  url: siteUrl.href,
  description: SITE.description,
  address: {
    '@type': 'PostalAddress',
    postalCode: SITE.address.postalCode,
    addressRegion: SITE.address.region,
    addressLocality: SITE.address.locality,
    streetAddress: SITE.address.street,
    addressCountry: 'JP',
  },
  areaServed: SITE.areaServed.map((name) => ({ '@type': 'AdministrativeArea', name })),
  identifier: {
    '@type': 'PropertyValue',
    name: '宅地建物取引業免許番号',
    value: SITE.licenseNumber,
  },
  knowsAbout: ['武蔵小杉', '川崎市', '横浜市', '仲介手数料', '不動産売買', '賃貸仲介'],
  makesOffer: [
    {
      '@type': 'Offer',
      name: '売買仲介',
      description: `仲介手数料 ${SITE.fees.sale}（${SITE.fees.saleNote}）`,
      areaServed: SITE.areaServed.join('・'),
    },
    {
      '@type': 'Offer',
      name: '賃貸仲介',
      description: `仲介手数料 ${SITE.fees.rent}`,
      areaServed: SITE.areaServed.join('・'),
    },
  ],
  ...(SITE.tel ? { telephone: SITE.tel } : {}),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', siteUrl).href,
  url: siteUrl.href,
  name: SITE.name,
  inLanguage: 'ja',
  publisher: { '@id': orgId },
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400;600&family=Shippori+Mincho:wght@400;600;800&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&display=swap"
      rel="stylesheet"
    />

    <JsonLd data={organizationSchema} />
    <JsonLd data={websiteSchema} />
    {jsonLd && <JsonLd data={jsonLd} />}
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
