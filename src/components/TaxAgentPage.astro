---
/**
 * 納税管理人ページ（/nozei-kanrinin/ ・ /en/tax-agent/）。内容は src/lib/tax-agent.ts。
 * 見た目は目的別ページ（PurposePage）と共通の src/styles/purpose.css を使う。
 */
import '../styles/home.css';
import '../styles/purpose.css';
import Base from '../layouts/Base.astro';
import Faq from './Faq.astro';
import ContactForm from './ContactForm.astro';
import { getTaxAgentPage, TAX_AGENT_PATH, TAX_AGENT_FEE_USD } from '../lib/tax-agent';
import { getPosts, postPath, postSlug } from '../lib/blog';
import { siteFor } from '../config/site';
import { formatDate, localePath, otherLocale, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ja = locale === 'ja';
const page = getTaxAgentPage(locale);
const site = siteFor(locale);
const t = {
  flow: ja ? 'ご利用の流れ' : 'How it works',
  faq: ja ? 'よくある質問' : 'Frequently asked questions',
  related: ja ? '関連する記事' : 'Related articles',
  allPosts: ja ? '記事一覧 →' : 'All articles →',
  contactNote: ja ? '「ご相談の種類」は選択済みです。' : 'The inquiry type is preselected.',
};

const posts = await getPosts(locale);
const relatedSlugs = [page.articleSlug, 'kaigai-kara-shiharai-wise', 'stablecoin-chukai-tesuryo'];
const related = relatedSlugs.map((s) => posts.find((p) => postSlug(p) === s)).filter((p) => p !== undefined);

const siteUrl = Astro.site ?? new URL(site.url);
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ja ? 'ホーム' : 'Home', item: new URL(localePath(locale, '/'), siteUrl).href },
      { '@type': 'ListItem', position: 2, name: page.label, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: ja ? '納税管理人の受託（海外にお住まいの方）' : 'Tax agent (nozei kanrinin) service for owners living outside Japan',
    description: page.description,
    url: pageUrl,
    provider: { '@id': new URL('/#organization', siteUrl).href },
    areaServed: { '@type': 'Country', name: ja ? '日本' : 'Japan' },
    offers: {
      '@type': 'Offer',
      price: String(TAX_AGENT_FEE_USD),
      priceCurrency: 'USD',
      description: ja ? '1年分・前払い' : 'Per year, paid in advance',
    },
  },
];
---

<Base title={page.title} description={page.description} locale={locale} alternate={TAX_AGENT_PATH[otherLocale(locale)]} jsonLd={jsonLd}>
  <section class="purpose-hero">
    <div class="container">
      <span class="section-label">{page.eyebrow}</span>
      <h1 class="section-title">{page.h1}</h1>
      <p class="purpose-lead">{page.lead}</p>
      <div class="purpose-fees">
        <span class="purpose-fees-label">{page.priceLabel}</span>
        <span class="purpose-fee tax-agent-price">{page.price}</span>
      </div>
      <p class="purpose-fee-note">{page.priceNote}</p>
      <a class="purpose-cta" href="#contact">{page.ctaTitle} →</a>
    </div>
  </section>

  <section class="purpose-body">
    <div class="container">
      <div class="tax-agent-scope">
        <div class="tax-agent-box">
          <h2>{page.doLabel}</h2>
          <ul>{page.doList.map((li) => <li>{li}</li>)}</ul>
        </div>
        <div class="tax-agent-box tax-agent-box-no">
          <h2>{page.dontLabel}</h2>
          <ul>{page.dontList.map((li) => <li>{li}</li>)}</ul>
        </div>
      </div>

      {page.sections.map((s) => (
        <article class="qa">
          <h2>{s.q}</h2>
          <p class="qa-answer"><strong>{s.a}</strong></p>
          {s.body?.map((b) => <p>{b}</p>)}
          {s.list && (
            <ul>
              {s.list.map((li) => <li>{li}</li>)}
            </ul>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="purpose-flow">
    <div class="container">
      <span class="section-label">How It Works</span>
      <h2 class="section-title">{t.flow}</h2>
      <ol class="steps">
        {page.steps.map((st, i) => (
          <li>
            <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{st.title}</h3>
              <p>{st.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="purpose-faq">
    <div class="container">
      <span class="section-label">FAQ</span>
      <h2 class="section-title">{t.faq}</h2>
      <Faq items={page.faq} />
    </div>
  </section>

  {related.length > 0 && (
    <section class="purpose-related">
      <div class="container">
        <div class="related-head">
          <div>
            <span class="section-label">Blog</span>
            <h2 class="section-title">{t.related}</h2>
          </div>
          <a class="related-more" href={localePath(locale, '/blog/')}>{t.allPosts}</a>
        </div>
        <ul class="related-list">
          {related.map((post) => (
            <li>
              <a href={postPath(post)}>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time>
                <span class="related-title">{post.data.title}</span>
                <span class="related-desc">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="contact-section purpose-contact" id="contact">
    <div class="container">
      <div class="contact-inner">
        <div class="contact-left">
          <span class="section-label">Contact</span>
          <h2 class="section-title">{page.ctaTitle}</h2>
          <p class="section-body">{ja ? '来店は不要です。3営業日以内にご返信します。' : 'No office visit needed. We reply within 3 business days.'} {t.contactNote}</p>
          {site.lineUrl && (
            <a class="line-btn" href={site.lineUrl} target="_blank" rel="noopener">{ja ? 'LINEで相談する' : 'Message us on LINE'}</a>
          )}
        </div>
        <ContactForm locale={locale} defaultType="tax_agent" reveal={false} />
      </div>
    </div>
  </section>
</Base>

<style>
  .tax-agent-price {
    font-size: 1.6rem;
  }
  .tax-agent-scope {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }
  .tax-agent-box {
    background: var(--cream);
    border: 1px solid var(--border);
    border-top: 3px solid var(--gold);
    padding: 1.4rem 1.6rem;
  }
  .tax-agent-box-no {
    border-top-color: var(--muted);
  }
  .tax-agent-box h2 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.8rem;
  }
  .tax-agent-box ul {
    margin-left: 1.2rem;
  }
  .tax-agent-box li {
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--charcoal);
    margin-bottom: 0.4rem;
  }
  @media (max-width: 700px) {
    .tax-agent-scope {
      grid-template-columns: 1fr;
    }
  }
</style>

<script src="../scripts/reveal.ts"></script>
