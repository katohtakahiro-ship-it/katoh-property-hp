---
/**
 * 目的別ページ（借りたい / 買いたい / 売りたい）の共通レイアウト。内容は src/lib/purpose-pages.ts。
 * 質問形式の見出し + 結論、流れ、FAQ（FAQPage JSON-LD）、種類を選択済みの問い合わせフォーム。
 */
import '../styles/home.css';
import '../styles/purpose.css';
import Base from '../layouts/Base.astro';
import Faq from './Faq.astro';
import ContactForm from './ContactForm.astro';
import { getPurposePages, PURPOSE_KEYS, RELATED_TAGS, type PurposeKey } from '../lib/purpose-pages';
import { getPosts, postPath } from '../lib/blog';
import { formatDate } from '../i18n';
import { siteFor } from '../config/site';
import { localePath, otherLocale, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  purpose: PurposeKey;
}
const { locale, purpose } = Astro.props;
const ja = locale === 'ja';
const pages = getPurposePages(locale);
const page = pages[purpose];
const site = siteFor(locale);
const relatedTags = RELATED_TAGS[purpose][locale].map((t) => t.toLowerCase());
const related = (await getPosts(locale)).filter((p) => p.data.tags.some((t) => relatedTags.includes(t.toLowerCase()))).slice(0, 3);
const others = PURPOSE_KEYS.filter((k) => k !== purpose).map((k) => pages[k]);
const t = {
  flow: ja ? 'ご利用の流れ' : 'How it works',
  faq: ja ? 'よくある質問' : 'Frequently asked questions',
  others: ja ? 'ほかの目的' : 'Other services',
  related: ja ? '関連する記事' : 'Related articles',
  allPosts: ja ? '記事一覧 →' : 'All articles →',
  fees: ja ? '仲介手数料' : 'Brokerage fees',
  contactNote: ja ? '「ご相談の種類」は選択済みです。' : 'The inquiry type is preselected.',
};

const siteUrl = Astro.site ?? new URL(site.url);
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ja ? 'ホーム' : 'Home', item: new URL(localePath(locale, '/'), siteUrl).href },
    { '@type': 'ListItem', position: 2, name: page.label, item: pageUrl },
  ],
};
---

<Base title={page.title} description={page.description} locale={locale} alternate={localePath(otherLocale(locale), `/${purpose}/`)} jsonLd={breadcrumb}>
  <section class="purpose-hero">
    <div class="container">
      <span class="section-label">{page.eyebrow}</span>
      <h1 class="section-title">{page.title.split('｜')[0].split(' | ')[0]}</h1>
      <p class="purpose-lead">{page.lead}</p>
      <div class="purpose-fees">
        <span class="purpose-fees-label">{t.fees}</span>
        <span class="purpose-fee"><small>{ja ? '賃貸' : 'Rentals'}</small>{site.fees.rent}</span>
        <span class="purpose-fee"><small>{ja ? '売買' : 'Sales'}</small>{site.fees.sale}</span>
      </div>
      <p class="purpose-fee-note">{site.fees.condition}</p>
      <a class="purpose-cta" href="#contact">{page.ctaTitle} →</a>
      {purpose === 'buy' && (<a class="purpose-satei-link" href={ja ? '/blog/portal-bukken-url-chukai/' : '/en/blog/portal-bukken-url-chukai/'}>{ja ? 'SUUMOなどで見つけた物件も、URLを送るだけで当社が仲介します →' : 'Found a property on SUUMO? Send us the link →'}</a>)}
      {purpose === 'sell' && (<a class="purpose-satei-link" href={ja ? '/sell/satei/' : '/en/sell/valuation/'}>{ja ? '川崎市のマンションの価格の目安を、その場で調べる（簡易査定）→' : 'Estimate your Kawasaki condo’s price instantly →'}</a>)}
    </div>
  </section>

  <section class="purpose-body">
    <div class="container">
      {page.sections.map((s) => (
        <article class="qa">
          <h2>{s.q}</h2>
          <p class="qa-answer"><strong>{s.a}</strong></p>
          {s.body?.map((b) => <p>{b}</p>)}
          {s.list && (
            <ul>
              {s.list.map((li) => <li>{li}</li>)}
            </ul>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="purpose-flow">
    <div class="container">
      <span class="section-label">How It Works</span>
      <h2 class="section-title">{t.flow}</h2>
      <ol class="steps">
        {page.steps.map((st, i) => (
          <li>
            <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{st.title}</h3>
              <p>{st.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="purpose-faq">
    <div class="container">
      <span class="section-label">FAQ</span>
      <h2 class="section-title">{t.faq}</h2>
      <Faq items={page.faq} />
    </div>
  </section>

  {related.length > 0 && (
    <section class="purpose-related">
      <div class="container">
        <div class="related-head">
          <div>
            <span class="section-label">Blog</span>
            <h2 class="section-title">{t.related}</h2>
          </div>
          <a class="related-more" href={localePath(locale, '/blog/')}>{t.allPosts}</a>
        </div>
        <ul class="related-list">
          {related.map((post) => (
            <li>
              <a href={postPath(post)}>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time>
                <span class="related-title">{post.data.title}</span>
                <span class="related-desc">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="purpose-others">
    <div class="container">
      <span class="section-label">{t.others}</span>
      <ul class="others">
        {others.map((o) => (
          <li><a href={o.path}>{o.label}<span>{o.title.split('｜')[0].split(' | ')[0]}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="contact-section purpose-contact" id="contact">
    <div class="container">
      <div class="contact-inner">
        <div class="contact-left">
          <span class="section-label">Contact</span>
          <h2 class="section-title">{page.ctaTitle}</h2>
          <p class="section-body">{ja ? '来店は不要です。3営業日以内にご返信します。' : 'No office visit needed. We reply within 3 business days.'} {t.contactNote}</p>
          {site.lineUrl && (
            <a class="line-btn" href={site.lineUrl} target="_blank" rel="noopener">{ja ? 'LINEで相談する' : 'Message us on LINE'}</a>
          )}
        </div>
        <ContactForm locale={locale} defaultType={purpose} reveal={false} />
      </div>
    </div>
  </section>
</Base>


<script src="../scripts/reveal.ts"></script>
