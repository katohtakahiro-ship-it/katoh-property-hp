---
import { siteFor } from '../config/site';
import Logo from './Logo.astro';
import { getPurposePages, PURPOSE_KEYS } from '../lib/purpose-pages';
import { localePath, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'ja' } = Astro.props;
const site = siteFor(locale);
const year = new Date().getFullYear();
const purposes = getPurposePages(locale);
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-inner">
      <div>
        <div class="footer-logo"><Logo locale={locale} /></div>
        <p class="footer-license">{site.license}</p>
        <p class="footer-links">
          {PURPOSE_KEYS.map((k) => <a href={purposes[k].path}>{purposes[k].label}</a>)}
          <a href={localePath(locale, "/blog/")}>{locale === "ja" ? "ブログ" : "Blog"}</a>
          <a href={localePath(locale, "/privacy/")}>{locale === "ja" ? "プライバシーポリシー" : "Privacy Policy"}</a>
        </p>
      </div>
      <address class="footer-meta">
        {site.address.full}<br />
        {site.name}<br />
        © {year} {site.name}
      </address>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #111120;
    padding: 3rem 0;
    border-top: 1px solid rgba(201, 168, 76, 0.15);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-logo {
    color: var(--cream);
    line-height: 0;
  }

  .footer-license {
    font-size: 0.75rem;
    color: rgba(250, 248, 243, 0.35);
    margin-top: 0.5rem;
  }

  .footer-links {
    margin-top: 0.6rem;
    font-size: 0.75rem;
  }

  .footer-links a {
    color: rgba(250, 248, 243, 0.5);
    text-decoration: none;
    margin-right: 1.2rem;
  }

  .footer-links a:hover {
    color: var(--gold);
  }

  .footer-meta {
    font-style: normal;
    font-size: 0.75rem;
    color: rgba(250, 248, 243, 0.35);
    line-height: 1.8;
    text-align: right;
  }

  @media (max-width: 600px) {
    .footer-meta {
      text-align: left;
    }
  }
</style>
