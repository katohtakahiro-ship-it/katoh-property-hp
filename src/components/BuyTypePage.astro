---
/**
 * 物件種別ページ（/buy/ の下：中古マンションなど）の共通レイアウト。内容は src/lib/buy-type-pages.ts。
 * PurposePage と同じ型（質問見出し＋結論、流れ、FAQ、問い合わせ）に、表・リンク・出典注記・Service JSON-LD を足したもの。
 */
import '../styles/home.css';
import '../styles/purpose.css';
import Base from '../layouts/Base.astro';
import Faq from './Faq.astro';
import ContactForm from './ContactForm.astro';
import { getBuyTypePages, BUY_TYPE_PATH, type BuyTypeKey } from '../lib/buy-type-pages';
import { getPurposePages } from '../lib/purpose-pages';
import { getPosts, postPath, postSlug } from '../lib/blog';
import { formatDate, localePath, otherLocale, type Locale } from '../i18n';
import { siteFor } from '../config/site';

interface Props {
  locale: Locale;
  type: BuyTypeKey;
}
const { locale, type } = Astro.props;
const ja = locale === 'ja';
const page = getBuyTypePages(locale)[type];
const purposes = getPurposePages(locale);
const site = siteFor(locale);
const posts = await getPosts(locale);
const related = page.relatedSlugs.map((s) => posts.find((p) => postSlug(p) === s)).filter((p) => p !== undefined);
const others = [purposes.buy, purposes.sell];
const t = {
  flow: ja ? 'ご利用の流れ' : 'How it works',
  faq: ja ? 'よくある質問' : 'Frequently asked questions',
  others: ja ? 'あわせて見る' : 'See also',
  related: ja ? '関連する記事' : 'Related articles',
  allPosts: ja ? '記事一覧 →' : 'All articles →',
  fees: ja ? '仲介手数料' : 'Brokerage fee',
  contactNote: ja ? '「ご相談の種類」は「買いたい」を選択済みです。' : 'The inquiry type is preset to Buy.',
};

const siteUrl = Astro.site ?? new URL(site.url);
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const h1 = page.title.split('｜')[0].split(' | ')[0];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ja ? 'ホーム' : 'Home', item: new URL(localePath(locale, '/'), siteUrl).href },
      { '@type': 'ListItem', position: 2, name: purposes.buy.label, item: new URL(purposes.buy.path, siteUrl).href },
      { '@type': 'ListItem', position: 3, name: page.label, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${pageUrl}#service`,
    name: h1,
    serviceType: page.serviceType,
    description: page.description,
    url: pageUrl,
    provider: { '@id': new URL('/#organization', siteUrl).href },
    areaServed: site.areaServedCities.map((name) => ({ '@type': 'City', name })),
    offers: {
      '@type': 'Offer',
      description: `${t.fees}: ${site.fees.sale}（${site.fees.saleNote}） ${site.fees.condition}`,
    },
  },
];
---

<Base title={page.title} description={page.description} locale={locale} alternate={BUY_TYPE_PATH[type][otherLocale(locale)]} jsonLd={jsonLd}>
  <section class="purpose-hero">
    <div class="container">
      <nav class="type-breadcrumb" aria-label={ja ? 'パンくずリスト' : 'Breadcrumb'}>
        <a href={localePath(locale, '/')}>{ja ? 'ホーム' : 'Home'}</a> › <a href={purposes.buy.path}>{purposes.buy.label}</a> › <span>{page.label}</span>
      </nav>
      <span class="section-label">{page.eyebrow}</span>
      <h1 class="section-title">{h1}</h1>
      <p class="purpose-lead">{page.lead}</p>
      <div class="purpose-fees">
        <span class="purpose-fees-label">{t.fees}</span>
        <span class="purpose-fee"><small>{ja ? '購入' : 'Buying'}</small>{site.fees.sale}</span>
      </div>
      <p class="purpose-fee-note">{site.fees.condition}</p>
      <a class="purpose-cta" href="#contact">{page.ctaTitle} →</a>
    </div>
  </section>

  <section class="purpose-body">
    <div class="container">
      {page.sections.map((s) => (
        <article class="qa">
          <h2>{s.q}</h2>
          <p class="qa-answer"><strong>{s.a}</strong></p>
          {s.table && (
            <p class="type-table-caption" aria-hidden="true">{s.table.caption}</p>
            <div class="type-table-wrap">
              <table class="type-table">
                <caption class="visually-hidden">{s.table.caption}</caption>
                <thead><tr>{s.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
                <tbody>
                  {s.table.rows.map((r) => (
                    <tr class:list={{ 'is-city': r[0].includes('全体') || r[0].includes('whole city') }}>
                      <th scope="row">{r[0]}</th>
                      {r.slice(1).map((c) => <td>{c}</td>)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          {s.table?.note && <p class="type-table-note">{s.table.note}</p>}
          {s.body?.map((b) => <p>{b}</p>)}
          {s.list && (
            <ul>
              {s.list.map((li) => <li>{li}</li>)}
            </ul>
          )}
          {s.links && (
            <ul class="type-links">
              {s.links.map((l) => (
                <li>{l.external ? <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a> : <a href={l.href}>{l.label} →</a>}</li>
              ))}
            </ul>
          )}
        </article>
      ))}
      {page.notes.map((n) => <p class="type-source-note">{n}</p>)}
    </div>
  </section>

  <section class="purpose-flow">
    <div class="container">
      <span class="section-label">How It Works</span>
      <h2 class="section-title">{t.flow}</h2>
      <ol class="steps">
        {page.steps.map((st, i) => (
          <li>
            <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{st.title}</h3>
              <p>{st.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="purpose-faq">
    <div class="container">
      <span class="section-label">FAQ</span>
      <h2 class="section-title">{t.faq}</h2>
      <Faq items={page.faq} />
    </div>
  </section>

  {related.length > 0 && (
    <section class="purpose-related">
      <div class="container">
        <div class="related-head">
          <div>
            <span class="section-label">Blog</span>
            <h2 class="section-title">{t.related}</h2>
          </div>
          <a class="related-more" href={localePath(locale, '/blog/')}>{t.allPosts}</a>
        </div>
        <ul class="related-list">
          {related.map((post) => (
            <li>
              <a href={postPath(post)}>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time>
                <span class="related-title">{post.data.title}</span>
                <span class="related-desc">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="purpose-others">
    <div class="container">
      <span class="section-label">{t.others}</span>
      <ul class="others">
        {others.map((o) => (
          <li><a href={o.path}>{o.label}<span>{o.title.split('｜')[0].split(' | ')[0]}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="contact-section purpose-contact" id="contact">
    <div class="container">
      <div class="contact-inner">
        <div class="contact-left">
          <span class="section-label">Contact</span>
          <h2 class="section-title">{page.ctaTitle}</h2>
          <p class="section-body">{ja ? '来店は不要です。3営業日以内にご返信します。' : 'No office visit needed. We reply within 3 business days.'} {t.contactNote}</p>
          {site.lineUrl && (
            <a class="line-btn" href={site.lineUrl} target="_blank" rel="noopener">{ja ? 'LINEで相談する' : 'Message us on LINE'}</a>
          )}
        </div>
        <ContactForm locale={locale} defaultType="buy" reveal={false} />
      </div>
    </div>
  </section>
</Base>

<style>
  .type-breadcrumb {
    font-size: 0.8rem;
    color: rgba(250, 248, 243, 0.7);
    margin-bottom: 1.2rem;
  }
  .type-breadcrumb a {
    color: inherit;
  }
  .type-table-wrap {
    overflow-x: auto;
    margin: 1.5rem 0 0.6rem;
  }
  .type-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  .type-table-caption {
    font-weight: 700;
    color: var(--ink) !important;
    margin: 1.5rem 0 0 !important;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .type-table th,
  .type-table td {
    border: 1px solid var(--border);
    padding: 0.55rem 0.8rem;
    text-align: left;
    white-space: nowrap;
  }
  .type-table td {
    text-align: right;
  }
  .type-table thead th {
    background: var(--cream);
    font-weight: 600;
  }
  .type-table tbody th {
    font-weight: 500;
  }
  .type-table tr.is-city th,
  .type-table tr.is-city td {
    background: var(--cream);
    font-weight: 700;
  }
  .type-table-note,
  .type-source-note {
    font-size: 0.8rem !important;
    line-height: 1.8 !important;
    color: var(--charcoal);
  }
  .type-source-note {
    margin-top: 3rem;
  }
  .type-links {
    list-style: none;
    margin-left: 0 !important;
  }
  .type-links a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 3px;
  }
</style>

<script src="../scripts/reveal.ts"></script>
