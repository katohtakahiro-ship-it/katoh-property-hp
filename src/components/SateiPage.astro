---
/**
 * 売却の簡易査定（日英共用。/sell/satei/ と /en/sell/valuation/、/sell/ からリンク）。
 * データは東京都・神奈川県の全市区町村分あるが、当面は川崎市7区だけで査定する（スクリプトの ENABLED）。
 * マンションは、市区町村・面積・築年（またはマンション名）から国交省の成約価格情報で売れる価格の目安を出す。
 * 戸建て・土地は用途地域や接道で価格が大きく変わるため目安は出さず、市区町村の㎡単価の推移だけ見せて本格査定へつなぐ。
 * 計算はブラウザ内で完結し、データは scripts/satei_data.py が作る public/data/satei/。
 * 英語版は町名（日本語のみのデータ）を出さず、マンション名は日本語表記のまま（市区町村は英語表記でも探せる）。
 */
import '../styles/home.css';
import Base from '../layouts/Base.astro';
import Faq from './Faq.astro';
import ContactForm from './ContactForm.astro';
import { siteFor } from '../config/site';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ja = locale === 'ja';
const site = siteFor(locale);
const PATH = { ja: '/sell/satei/', en: '/en/sell/valuation/' } as const;

const content = {
  ja: {
    title: 'マンション売却の簡易査定｜川崎市の価格の目安を成約データで',
    description:
      '川崎市（7区）の中古マンションの売却価格の目安を、国土交通省の成約価格データと最近の成約からその場で計算します。マンション名・所在階でも調べられます。名前や連絡先の入力は不要。横浜市・東京都内は順次対応します。',
    h1: ['売却価格の目安を、', '国の成約データで確かめる'],
    lead: '川崎市（7区）の中古マンションについて、国土交通省の成約データと当社が確認している最近の成約から、売れる価格の目安をその場で計算します。お名前やご連絡先の入力はいりません。営業電話もしません。横浜市・東京都内は順次対応します。それ以外の地域と戸建て・土地は、当社が調べて本格査定でお出しします。',
    feeLabel: '売却の仲介手数料',
    tool: '簡易査定',
    kinds: { legend: '物件の種類', mansion: 'マンション', house: '戸建て', land: '土地' },
    building: 'マンション名（任意）',
    buildingPlaceholder: '例：パークシティ、武蔵小杉、小倉',
    muni: '区',
    district: '町名（任意）',
    districtAny: '指定しない',
    area: '専有面積（㎡）',
    built: '築年（西暦）',
    floor: '所在階（タワーのみ・任意）',
    info: '戸建て・土地は、用途地域・前面道路・土地の形で価格が大きく変わるため、ここでは価格の目安を出しません。当社が調べて、本格査定でお出しします。参考に、選んだ市区町村の土地1㎡あたりの価格の推移を表示できます。',
    submit: '目安を計算する →',
    resultLabel: '売却価格の目安',
    range: '多くの事例が収まる範囲：',
    unit: '㎡単価（中央値）',
    count: '使った事例',
    period: '期間',
    tableTitle: '条件の近い成約事例',
    tableHead: ['成約時期', '町名', '面積', '築年', '成約価格', '時点修正後の㎡単価'],
    toForm: '本格査定を依頼する →',
    line: 'LINEで依頼する',
    flowTitle: '簡易査定から本格査定までの流れ',
    faqTitle: 'よくある質問',
    contactTitle: '本格査定のご依頼',
    contactBody: '来店は不要です。3営業日以内にメールでご返信します。簡易査定で入力した内容は、物件種別・所在地・マンション名・メッセージ欄に自動で入ります。',
    sections: [
      {
        q: 'この簡易査定の価格は、どう計算していますか？',
        a: '国土交通省が公表している中古マンションの成約価格から、同じ市区町村で専有面積と築年が近い事例を選び、㎡単価の中央値に面積を掛けて出しています。',
        body: [
          '使うのは直近2年（8四半期）の成約事例です。条件に合う事例が少ない場合は、直近3年まで期間を広げます。ここ数年は価格の上昇が大きいため、3年より前の事例は使いません。事例は、その市区町村の㎡単価の動きをもとに、最新の四半期の水準に直してから使います（時点修正）。',
          '町名を選ぶと、その町の事例を件数に応じて重みづけします。マンション名を選ぶと、そのマンションとみられる直近3年の事例（同じ町・同じ築年）の集計で計算します。事例が10件に満たない場合は、近くの築年・広さが近いマンションの事例で補います。',
          '国のデータは公表が数か月遅れ、価格も丸められているため、そのままでは最近の成約より低めに出ます。当社が毎月確認している最近の成約事例と比べ、そのずれの分を上乗せしています（率は結果に表示します）。',
          'タワーマンション（20階建て以上）をマンション名で選んだ場合は、所在階を入れると階数による差を反映します。同じ建物の中で、最下階と最上階の差はおよそ15%です。向き・眺望・室内の状態は反映していません。',
        ],
      },
      {
        q: '戸建て・土地の簡易査定はできますか？',
        a: '戸建て・土地は、価格の目安を表示せず、当社が調べて本格査定でお出しします。',
        body: [
          '戸建て・土地の価格は、用途地域、前面道路の幅や接し方、土地の形、日当たりで大きく変わります。同じ町内でも、商業地域と住宅地では土地1㎡あたりの価格が2倍以上違うことがあります。国の取引データだけでは、こうした違いを正しく反映できません。',
          '本格査定では、公示地価・路線価・用途地域・接道の状況を当社で調べ、近くの成約事例と比べて価格を出します。お客様が用途地域などを調べていただく必要はありません。',
        ],
      },
      {
        q: '本格的な査定では、何をしますか？',
        a: '簡易査定の結果に、レインズの成約事例、いま売り出し中の競合物件、管理状況や法令上の制限、現地確認の結果を加えて、根拠の事例付きの査定報告書（PDF）をお渡しします。',
        list: [
          'レインズ（不動産会社だけが使える取引情報システム）で、近くの物件の成約事例を、階数・向き・接道・成約時期まで確認します',
          'いま売り出し中の物件と、売れ残っている物件の価格を確認します',
          'マンションは管理規約・修繕積立金・長期修繕計画を、戸建て・土地は公示地価・路線価・用途地域・接道の状況を確認します',
          '現地で建物・室内・周辺の環境を拝見します（来店は不要で、当社が伺います）',
          '「チャレンジ価格」「おすすめの売出価格」「成約が見込める価格」「早く売りたい場合の価格」と、お手取りの試算を、オンラインでご説明します',
        ],
        body: ['査定の費用はかかりません。仲介手数料は、売買契約が成立したときにだけ発生します。'],
      },
      {
        q: '査定を依頼したら、営業電話がかかってきますか？',
        a: 'かかってきません。当社はご連絡をメールか LINE でお送りし、こちらから電話をかけることはしません。',
        body: ['一括査定サイトのように複数の会社へ情報が渡ることもありません。ご依頼の情報は当社だけが扱います。'],
      },
      {
        q: '売却の仲介手数料はいくらですか？',
        a: `${site.fees.sale}です。7,000万円で売れた場合、法定上限との差は1,188,000円になります。`,
        body: [site.fees.condition],
      },
    ],
    steps: [
      { title: '簡易査定', body: '川崎市のマンションは、このページで価格の目安を確かめます。お名前やご連絡先の入力はいりません。それ以外の地域や戸建て・土地は、次の本格査定のご依頼から始まります。' },
      { title: '本格査定のご依頼', body: 'フォームか LINE で、物件の所在地・売りたい時期をお送りください。' },
      { title: '机上査定', body: 'レインズの成約事例、売出中の物件、管理状況や法令上の制限を確認します。' },
      { title: '現地確認', body: '建物・室内・周辺の環境を拝見します。所要時間は30分〜1時間ほどです。' },
      { title: '査定報告書のご説明', body: '根拠の事例付きの報告書（PDF）をお渡しし、オンラインでご説明します。売却するかどうかは、そのあとでご判断ください。' },
    ],
    faq: [
      { q: '簡易査定に名前や電話番号の入力は必要ですか？', a: '必要ありません。市区町村・専有面積・築年（またはマンション名）を入れるだけで、その場で目安が表示されます。入力した内容は当社に送信されません。' },
      { q: '簡易査定の対象はどこですか？', a: 'いまは川崎市（7区）の中古マンションです。国のデータと最近の成約の差を地域ごとに確かめてから広げるため、横浜市・東京都内は順次対応します。それ以外の地域の物件や戸建て・土地は、フォームか LINE で本格査定をご依頼ください（一都3県に対応しています）。' },
      { q: 'マンション名で調べられるのはどのマンションですか？', a: 'いまは川崎市の大規模マンションを登録していて、順次増やしています。一覧にないマンションも、名前を入力していただければ、町名・築年の近い事例で目安を出し、本格査定でそのマンションの事例をお調べします。' },
      { q: '簡易査定と本格査定の違いは何ですか？', a: '簡易査定は公的データだけで出す目安です。本格査定は、レインズの成約事例・売出中の物件・管理状況や法令上の制限・現地確認を加えて、その物件の価格を出します。' },
      { q: '査定に費用はかかりますか？', a: 'かかりません。仲介手数料は売買契約が成立したときにだけ発生します。' },
      { q: '査定を依頼したら、必ず売らないといけませんか？', a: 'いいえ。査定報告書をご覧になったうえで、売るかどうか、いつ売るかをご判断ください。' },
    ],
  },
  en: {
    title: 'Condo valuation in Kawasaki | Price estimate from actual sale data',
    description:
      'Get an instant price estimate for a second-hand condominium in Kawasaki, calculated from the government’s record of actual sale prices and recent sales. Search by building name and floor. No name or contact details needed. Yokohama and Tokyo are coming soon.',
    h1: ['What is your condo worth?', 'Check it against actual sale prices'],
    lead: 'For second-hand condominiums in Kawasaki (all 7 wards), this tool estimates a likely sale price from the actual sale prices published by Japan’s Ministry of Land, Infrastructure, Transport and Tourism (MLIT) and the recent sales we track. No name or contact details are needed, and we never make sales calls. Yokohama and Tokyo are coming soon. For other areas, houses and land, we research the property and give you a price in a full valuation.',
    feeLabel: 'Our brokerage fee for sales',
    tool: 'Instant estimate',
    kinds: { legend: 'Property type', mansion: 'Condominium', house: 'House', land: 'Land' },
    building: 'Building name (optional)',
    buildingPlaceholder: 'Building name in Japanese, or a ward (e.g. Nakahara)',
    muni: 'Ward',
    district: 'Town (optional)',
    districtAny: 'Any',
    area: 'Floor area (㎡)',
    built: 'Year built',
    floor: 'Floor (towers only, optional)',
    info: 'Prices of houses and land vary greatly with zoning, the road in front and the shape of the plot, so we do not show an estimate here. We research the property and give you a price in a full valuation. You can view the trend of land prices per ㎡ in the selected city or ward for reference.',
    submit: 'Get an estimate →',
    resultLabel: 'Estimated sale price',
    range: 'Range covering most comparable sales: ',
    unit: 'Price per ㎡ (median)',
    count: 'Comparable sales',
    period: 'Period',
    tableTitle: 'Most comparable sales',
    tableHead: ['Sold', 'Town', 'Area', 'Built', 'Price', 'Price per ㎡ (adjusted to today)'],
    toForm: 'Request a full valuation →',
    line: 'Ask on LINE',
    flowTitle: 'From instant estimate to full valuation',
    faqTitle: 'Frequently asked questions',
    contactTitle: 'Request a full valuation',
    contactBody: 'No office visit needed. We reply by email within 3 business days. What you entered in the instant estimate is copied into the property type, location, building name and message fields.',
    sections: [
      {
        q: 'How is the estimate calculated?',
        a: 'From MLIT’s record of actual sale prices of second-hand condominiums, we pick sales in the same city or ward with a similar floor area and year built, and multiply the median price per ㎡ by your floor area.',
        body: [
          'We use sales from the last 2 years (8 quarters), widening to 3 years when there are too few. Because prices have risen sharply in recent years, we do not use anything older than 3 years. Older sales are adjusted to the latest quarter using the price trend of that city or ward.',
          'If you choose a building by name, we use the sales that appear to be in that building over the last 3 years (same town and year built). If there are fewer than 10, we add sales of nearby buildings of similar age and size.',
          'The government data is published a few months late and its prices are rounded, so on its own it comes out lower than recent sales. We compare it every month with the recent sales we track and add the difference (the rate is shown with the result).',
          'For tower condominiums (20 floors or more) chosen by name, entering the floor reflects the difference between floors: about 15% between the lowest and highest floors of the same building. Orientation, view and interior condition are not reflected.',
        ],
      },
      {
        q: 'Can I get an instant estimate for a house or land?',
        a: 'No. For houses and land we do not show an estimate; we research the property and give you a price in a full valuation.',
        body: [
          'House and land prices vary greatly with zoning, the width and frontage of the road, the shape of the plot and sunlight. Within the same town, land in a commercial zone can cost more than twice as much per ㎡ as land in a residential zone. Government transaction data alone cannot reflect these differences properly.',
          'In a full valuation we check the official land prices, roadside land values, zoning and road access ourselves, and compare with nearby sales. You do not need to look any of this up.',
        ],
      },
      {
        q: 'What does a full valuation include?',
        a: 'On top of the instant estimate, we add recent sales from REINS, competing listings currently on the market, the building’s management and legal restrictions, and an on-site inspection, and give you a valuation report (PDF) with the supporting sales.',
        list: [
          'We check comparable sales on REINS (the transaction database available only to licensed agents), including floor, orientation, road access and sale date',
          'We check the prices of listings currently on the market and of those that have not sold',
          'For condominiums we check the management rules, repair reserve fund and long-term repair plan; for houses and land, official land prices, roadside land values, zoning and road access',
          'We visit to see the building, the interior and the neighborhood (no office visit needed; we come to you)',
          'We explain online a “stretch price”, a recommended listing price, the price we expect it to sell for and a price for a quick sale, together with an estimate of your net proceeds',
        ],
        body: ['The valuation itself is free of charge. Our brokerage fee is payable only when a sale is concluded.'],
      },
      {
        q: 'Will I get sales calls after requesting a valuation?',
        a: 'No. We contact you by email or LINE and never call you.',
        body: ['Unlike multi-agent valuation sites, your details are not passed to other companies. Only we handle your request.'],
      },
      {
        q: 'How much is the brokerage fee for selling?',
        a: `Our fee is ${site.fees.sale}. If your home sells for ¥70 million, you save ¥1,188,000 compared with the legal maximum.`,
        body: [site.fees.condition],
      },
    ],
    steps: [
      { title: 'Instant estimate', body: 'For condominiums in Kawasaki, check an estimated price on this page. No name or contact details needed. For other areas, houses and land, start with a request for a full valuation.' },
      { title: 'Request a full valuation', body: 'Send us the location and when you would like to sell, using the form or LINE.' },
      { title: 'Desk research', body: 'We check recent sales on REINS, current listings, the building’s management and legal restrictions.' },
      { title: 'On-site inspection', body: 'We see the building, the interior and the neighborhood. It takes about 30 minutes to an hour.' },
      { title: 'Valuation report', body: 'We give you a report (PDF) with the supporting sales and explain it online. Decide whether to sell after that.' },
    ],
    faq: [
      { q: 'Do I need to enter my name or phone number for the instant estimate?', a: 'No. Enter the city or ward, floor area and year built (or the building name) and the estimate appears immediately. Nothing you enter is sent to us.' },
      { q: 'Which areas does the instant estimate cover?', a: 'For now, second-hand condominiums in Kawasaki (all 7 wards). We are checking the gap between the government data and recent sales area by area, and will add Yokohama and Tokyo next. For other areas, houses and land, please request a full valuation by form or LINE (we cover Tokyo, Kanagawa, Chiba and Saitama).' },
      { q: 'Which buildings can I search by name?', a: 'For now, large condominiums in Kawasaki, and we are adding more. Building names are listed in Japanese; you can also type a ward name in English, such as Nakahara, to see the buildings there. If your building is not listed, we estimate from similar sales and look up your building in the full valuation.' },
      { q: 'What is the difference between the instant estimate and a full valuation?', a: 'The instant estimate uses public data only. A full valuation adds recent REINS sales, current listings, the building’s management and legal restrictions, and an on-site inspection to price your specific property.' },
      { q: 'Is there a charge for the valuation?', a: 'No. Our brokerage fee is payable only when a sale is concluded.' },
      { q: 'Do I have to sell after requesting a valuation?', a: 'No. After seeing the report, you decide whether and when to sell.' },
    ],
  },
}[locale];
---

<Base title={content.title} description={content.description} locale={locale} alternate={PATH[ja ? 'en' : 'ja']}>
  <section class="purpose-hero">
    <div class="container">
      <span class="section-label">Valuation</span>
      <h1 class="section-title">{content.h1[0]}<br />{content.h1[1]}</h1>
      <p class="purpose-lead">{content.lead}</p>
      <div class="purpose-fees">
        <span class="purpose-fees-label">Fee</span>
        <span class="purpose-fee"><small>{content.feeLabel}</small>{site.fees.sale}</span>
      </div>
      <p class="purpose-fee-note">{site.fees.condition}</p>
    </div>
  </section>

  <section class="satei-tool" id="tool">
    <div class="container">
      <span class="section-label">Step 1</span>
      <h2 class="section-title">{content.tool}</h2>
      <form class="satei-form" id="satei-form" data-locale={locale}>
        <fieldset class="satei-kinds">
          <legend>{content.kinds.legend}</legend>
          <label><input type="radio" name="kind" value="mansion" checked /><span>{content.kinds.mansion}</span></label>
          <label><input type="radio" name="kind" value="house" /><span>{content.kinds.house}</span></label>
          <label><input type="radio" name="kind" value="land" /><span>{content.kinds.land}</span></label>
        </fieldset>
        <div class="satei-wide" data-for="mansion">
          <label for="satei-building"><span>{content.building}</span></label>
          <div class="satei-combo">
            <input type="text" id="satei-building" autocomplete="off" placeholder={content.buildingPlaceholder} role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="satei-bld-list" />
            <ul class="satei-combo-list" id="satei-bld-list" role="listbox" hidden></ul>
          </div>
          <small class="satei-hint" id="satei-building-hint"></small>
        </div>
        <label>
          <span>{content.muni}</span>
          <select name="muni" id="satei-muni" required></select>
        </label>
        {/* 町名は日本語のデータしかないので、英語版では出さない（マンション名を選んだときの内部の値には使う） */}
        <label data-for={ja ? 'mansion' : undefined} hidden={!ja}>
          <span>{content.district}</span>
          <select name="district" id="satei-district"><option value="">{content.districtAny}</option></select>
        </label>
        <label data-for="mansion">
          <span>{content.area}</span>
          <input type="number" id="satei-area" min="15" max="300" step="1" value="70" inputmode="numeric" />
        </label>
        <label data-for="mansion">
          <span>{content.built}</span>
          <input type="number" id="satei-built" min="1950" max="2026" step="1" value="2010" inputmode="numeric" />
        </label>
        <label id="satei-floorno-field" hidden>
          <span>{content.floor}</span>
          <input type="number" id="satei-floorno" min="1" max="80" step="1" inputmode="numeric" />
        </label>
        <p class="satei-wide satei-info" data-for="house land" hidden>{content.info}</p>
        <button type="submit" class="purpose-cta" id="satei-submit">{content.submit}</button>
      </form>

      <div class="satei-result" id="satei-result" hidden>
        <div id="r-price-block">
          <p class="satei-label" id="r-label">{content.resultLabel}</p>
          <p class="satei-price" id="r-mid"></p>
          <p class="satei-range">{content.range}<span id="r-range"></span></p>
          <dl class="satei-meta">
            <div><dt>{content.unit}</dt><dd id="r-unit"></dd></div>
            <div><dt>{content.count}</dt><dd id="r-count"></dd></div>
            <div><dt>{content.period}</dt><dd id="r-period"></dd></div>
          </dl>
        </div>
        <p class="satei-note" id="r-note"></p>

        <div id="r-detail">
          <h3 id="r-chart-title"></h3>
          <div class="satei-chart" id="r-chart"></div>

          <div id="r-table-block">
            <h3>{content.tableTitle}</h3>
            <div class="satei-table-wrap">
              <table class="satei-table">
                <thead><tr>{content.tableHead.map((h) => <th>{h}</th>)}</tr></thead>
                <tbody id="r-rows"></tbody>
              </table>
            </div>
          </div>
        </div>
        <p class="satei-source" id="r-source"></p>

        <div class="satei-next">
          <p id="r-next-text"></p>
          <a class="purpose-cta" href="#contact">{content.toForm}</a>
          {site.lineUrl && <a class="line-btn" href={site.lineUrl} target="_blank" rel="noopener">{content.line}</a>}
        </div>
      </div>
    </div>
  </section>

  <section class="purpose-body">
    <div class="container">
      {content.sections.map((s) => (
        <article class="qa">
          <h2>{s.q}</h2>
          <p class="qa-answer"><strong>{s.a}</strong></p>
          {s.list && <ul>{s.list.map((li) => <li>{li}</li>)}</ul>}
          {s.body?.map((b) => <p>{b}</p>)}
        </article>
      ))}
    </div>
  </section>

  <section class="purpose-flow">
    <div class="container">
      <span class="section-label">How It Works</span>
      <h2 class="section-title">{content.flowTitle}</h2>
      <ol class="steps">
        {content.steps.map((st, i) => (
          <li>
            <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{st.title}</h3>
              <p>{st.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="purpose-faq">
    <div class="container">
      <span class="section-label">FAQ</span>
      <h2 class="section-title">{content.faqTitle}</h2>
      <Faq items={content.faq} />
    </div>
  </section>

  <section class="contact-section purpose-contact" id="contact">
    <div class="container">
      <div class="contact-inner">
        <div class="contact-left">
          <span class="section-label">Step 2</span>
          <h2 class="section-title">{content.contactTitle}</h2>
          <p class="section-body">{content.contactBody}</p>
          {site.lineUrl && <a class="line-btn" href={site.lineUrl} target="_blank" rel="noopener">{content.line}</a>}
        </div>
        <ContactForm locale={locale} defaultType="sell" reveal={false} />
      </div>
    </div>
  </section>
</Base>

<script>
  type Kind = 'mansion' | 'house' | 'land';
  type Muni = { code: string; name: string; en: string; group: string; counts: Partial<Record<Kind, number>> };
  type Index = { quarters: string[]; last: Record<Kind, number>; munis: Muni[] };
  type Data = { code: string; name: string; districts: string[]; idx: number[]; deals: number[][] };
  /** マンション名の一覧。n 名前 / c 市区町村コード / d 町名 / y データ上の築年 / f 地上階数 / k 5年間の事例数 / s 同じ町・同じ築年の別の建物 */
  type Building = { n: string; c: string; d: string; y: number; u: number | null; f: number | null; k: number; s: string[] };
  /**
   * 補正率（scripts/reins_calibrate.py）。国のデータは公表が遅れ価格も丸められているため、当社が確認している最近の成約と
   * 比べた「実際÷目安」の中央値を掛ける。tower は建物の中ほどの階の水準で、所在階の補正は floor_slope ×（位置 − 0.5）
   */
  type Calibration = { asof: string; general: number; building: number; tower: number; floor_slope: number };

  const GROUPS = ['東京23区', '東京都 市部', '東京都 町村', '横浜市', '川崎市', '相模原市', '神奈川県 市部', '神奈川県 町村'];
  const MIN_COMPS = 5;
  const WANT = 12;
  /** マンション名で計算するのに必要な直近3年の事例数（これ未満なら近くの似たマンションで補う） */
  const MIN_BUILDING = 10;
  /** 使う事例の期間（四半期）。価格の上昇が続いているため、3年より前の事例は使わない */
  const RECENT = 12;
  /** 町名の事例をどれだけ信じるか。町名の事例 n 件と、市区町村全体（重み K）を混ぜる */
  const K = 6;
  /** これ以上の地上階数をタワーとして、所在階の補正をかける */
  const TOWER_FLOORS = 20;
  /**
   * 簡易査定を出す地域。最近の成約との比較（補正率）は川崎市の成約でしか確かめていないため、当面は川崎市7区だけにする。
   * 横浜市・東京都内は、レインズの成約で補正率を地域ごとに出せるようになってから加える
   */
  const ENABLED = (code: string) => code >= '14131' && code <= '14137';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const EN = $('satei-form').dataset.locale === 'en';
  const muniSel = $<HTMLSelectElement>('satei-muni');
  const distSel = $<HTMLSelectElement>('satei-district');
  const bldInput = $<HTMLInputElement>('satei-building');
  const val = (id: string) => Number($<HTMLInputElement>(id).value);
  const fmt = (n: number) => n.toLocaleString(EN ? 'en-US' : 'ja-JP');
  const qLabel = (q: string) => q.replace(/(\d{4})Q(\d)/, EN ? '$1 Q$2' : '$1年$2Q');
  const round10 = (n: number) => Math.round(n / 10) * 10;
  /** 金額（万円）の表示。英語は円 */
  const yen = (man: number) => (EN ? `¥${fmt(Math.round(man * 10000))}` : `${fmt(man)}万円`);
  const unitYen = (man: number) => (EN ? `¥${fmt(Math.round(man * 10) * 1000)}/㎡` : `${man.toFixed(1)}万円/㎡`);
  const pct = (v: number) => `${v >= 1 ? '+' : '−'}${Math.abs(Math.round((v - 1) * 1000) / 10)}%`;
  const month = (iso: string) => (EN ? new Date(`${iso.slice(0, 7)}-01`).toLocaleDateString('en-US', { year: 'numeric', month: 'long' }) : `${iso.slice(0, 4)}年${Number(iso.slice(5, 7))}月`);

  /** 画面に出す文言（日英） */
  const T = EN
    ? {
        kind: { mansion: 'condominium', house: 'house', land: 'land' } as Record<Kind, string>,
        group: { 東京23区: 'Tokyo 23 wards', '東京都 市部': 'Tokyo cities', '東京都 町村': 'Tokyo towns and villages', 横浜市: 'Yokohama', 川崎市: 'Kawasaki', 相模原市: 'Sagamihara', '神奈川県 市部': 'Kanagawa cities', '神奈川県 町村': 'Kanagawa towns and villages' } as Record<string, string>,
        submit: { mansion: 'Get an estimate →', other: 'See the price trend →' },
        hint: 'Suggestions appear as you type. For now, large condominiums in Kawasaki are listed (names in Japanese).',
        notListed: 'This building is not listed. Enter the city or ward and year built. The name will be passed on to your valuation request.',
        buildingHint: (b: Building) => `Calculated from sales in ${muniLabel(b.c)} built in ${b.y} (as recorded in the government data).`,
        emptyQuery: 'No buildings found. You can keep the name as typed and calculate.',
        emptyHere: (m: string) => `No buildings are listed for ${m} yet. Type a name to search other areas.`,
        ownSales: (b: Building, n: number, nearArea: boolean, A: number, _where = '') => `Based on ${n} sales over the last 3 years that appear to be in ${b.n}${nearArea ? `, limited to units of about ${A}㎡` : ''}. `,
        fillSales: (b: Building, n: number, where: string, m: number) => `Only ${n} sales over the last 3 years appear to be in ${b.n}, so we added ${m} sales of buildings of similar age (around ${b.y}) and size in ${where}${n ? `, weighting this building’s sales by their number` : ''}. `,
        sameTown: (b: Building) => `the same town`,
        shared: (s: string[]) => `Sales of ${s.join(', ')}, built in the same town and year, are also included. `,
        privacy: 'To avoid identifying individual sales, the list of sales is not shown when searching by building name. ',
        notListedCalc: (name: string) => `“${name}” is not listed, so the estimate uses sales with a similar location and year built. `,
        areaSales: (m: string, A: number, built: number) => `Sales in ${m} of units around ${A}㎡ built around ${built}. `,
        widened: 'There were too few sales in the last 2 years, so we used 3 years. ',
        townWeighted: (_town: string, _nd: number, _m: string) => '',
        noEstimate: 'Not enough comparable sales to give an estimate. We will look into it in a full valuation.',
        calib: (f: number, asof: string) => `Adjusted by ${pct(f)} to match recent sale prices (compared with the sales we track up to ${month(asof)}). `,
        floorAdj: (fl: number, tot: number, a: number) => `Floor adjustment (floor ${fl} of ${tot}): ${pct(a)}. `,
        floorTip: (s: number) => `Enter the floor to reflect the difference between floors (about ${Math.round(s * 100)}% between the lowest and highest). `,
        label: (b: Building | undefined) => (b ? `Estimated sale price: ${b.n}` : 'Estimated sale price'),
        count: (n: number) => `${n} sales`,
        chartMansion: (m: string) => `Condominium price per ㎡ in ${m} (quarterly median)`,
        chartUnit: '×¥10,000/㎡',
        source: (q: string) => `Source: MLIT Real Estate Information Library (contract prices). Latest data: ${q}; publication lags by a few months. This is an estimate based on public data, not a valuation report or a formal appraisal.`,
        nextMansion: '<strong>Want a precise price for your home?</strong><br />We give you a full valuation with recent REINS sales and an on-site inspection, free of charge.',
        trendNote: (k: Kind) => `Quarterly median of ${k === 'house' ? 'house sale prices (including the building) divided by land area' : 'land transaction prices per ㎡'}. It mixes properties with different zoning and road access, so it is not an estimate for any particular plot.`,
        chartTrend: (k: Kind, m: string) => (k === 'house' ? `House prices per ㎡ of land in ${m}` : `Land prices per ㎡ in ${m}`),
        sourceTrend: (k: Kind, q: string) => (k === 'land' ? 'Source: MLIT Real Estate Information Library (transaction prices, from a survey based on land registrations). ' : 'Source: MLIT Real Estate Information Library (contract prices). ') + `Latest data: ${q}.`,
        nextTrend: (k: Kind) => `<strong>We price ${k === 'house' ? 'houses' : 'land'} in a full valuation</strong><br />We check zoning, roadside land values and road access, and compare with nearby sales. Free of charge.`,
        chartFew: 'Too few sales per quarter to show the trend.',
        message: (kind: string, place: string, spec: string, summary: string) => `[Instant estimate] ${kind} / ${place}${spec ? ` / ${spec}` : ''}\n${summary}\nI would like a full valuation.`,
        spec: (b: string, fl: number, A: number, y: number) => `${b ? `${b} / ` : ''}${fl ? `floor ${fl} / ` : ''}${A}㎡ / built ${y}`,
        summary: (mid: number, lo: number, hi: number, n: number) => `Estimate ${yen(mid)} (${yen(lo)}–${yen(hi)}, ${n} sales)`,
        noSummary: { mansion: 'No estimate was shown', other: 'House or land: requesting a full valuation' },
        period: (a: string, b: string) => `${a} – ${b}`,
      }
    : {
        kind: { mansion: 'マンション', house: '戸建て', land: '土地' } as Record<Kind, string>,
        group: {} as Record<string, string>,
        submit: { mansion: '目安を計算する →', other: '価格の推移を見る →' },
        hint: '入力すると候補が出ます。いまは川崎市の大規模マンションを登録しています。',
        notListed: '一覧にないマンションです。市区町村・町名・築年を入れてください。名前は本格査定のご依頼に引き継ぎます。',
        buildingHint: (b: Building) => `${muniLabel(b.c)}${b.d}・築${b.y}年（国のデータ上）の事例で計算します。`,
        emptyQuery: '一覧にありません。このまま入力して計算できます。',
        emptyHere: (m: string) => `${m}の登録マンションはまだありません。名前を入力すると、ほかの地域からも探せます。`,
        ownSales: (b: Building, n: number, nearArea: boolean, A: number, where = '') => `${b.n}とみられる直近3年の事例（${where}・築${b.y}年）${n}件の集計です${nearArea ? `（専有面積${A}㎡前後に絞っています）` : ''}。`,
        fillSales: (b: Building, n: number, where: string, m: number) => `${b.n}とみられる直近3年の事例が${n}件と少ないため、${where}の築年（${b.y}年前後）と広さが近いマンションの事例${m}件で補っています${n ? `（このマンションの${n}件を件数に応じて重みづけ）` : ''}。`,
        sameTown: (b: Building) => `同じ${b.d}`,
        shared: (s: string[]) => `同じ町・同じ年に建った${s.join('、')}の事例も含まれます。`,
        privacy: '個別の取引が特定されないよう、マンション名で調べた場合は事例を一覧に表示しません。',
        notListedCalc: (name: string) => `「${name}」は一覧にないため、町名・築年の近い事例で計算しています。`,
        areaSales: (m: string, A: number, built: number) => `${m}で、専有面積${A}㎡前後・築${built}年前後の事例です。`,
        widened: '直近2年では事例が少ないため、3年分に広げています。',
        townWeighted: (town: string, nd: number, m: string) => (nd ? `町名（${town}）の事例${nd}件を重みづけしています${nd < 8 ? '（件数が少ないため、市区町村全体の水準も加味）' : ''}。` : `${town}の事例がないため、${m}全体で計算しています。`),
        noEstimate: '条件に合う事例が少ないため、目安を出せません。本格査定でお調べします。',
        calib: (f: number, asof: string) => `最近の成約の水準に合わせて、国のデータから出した値を${pct(f)}補正しています（当社が確認している${month(asof)}までの成約事例との比較）。`,
        floorAdj: (fl: number, tot: number, a: number) => `所在階（${fl}階／${tot}階建て）による補正：${pct(a)}。`,
        floorTip: (s: number) => `所在階を入れると、階数による差（最下階と最上階で約${Math.round(s * 100)}%）を反映します。`,
        label: (b: Building | undefined) => (b ? `${b.n}の売却価格の目安` : '売却価格の目安'),
        count: (n: number) => `${n}件`,
        chartMansion: (m: string) => `${m}のマンションの㎡単価の推移（四半期ごとの中央値）`,
        chartUnit: '万円/㎡',
        source: (q: string) => `出典：国土交通省 不動産情報ライブラリ（成約価格情報）。最新は${q}の分で、公表は数か月遅れます。この結果は公的データにもとづく目安で、査定書や不動産鑑定評価ではありません。`,
        nextMansion: '<strong>この物件の価格を詳しく知りたい方へ</strong><br />レインズの成約事例と現地確認を加えた本格査定を、費用をいただかずに行います。',
        trendNote: (k: Kind) => `${k === 'house' ? '戸建ての成約価格（建物を含む）を土地面積で割った値' : '土地の取引価格の㎡単価'}の、四半期ごとの中央値です。用途地域や接道の違う取引がまざっているため、個別の土地の価格の目安にはなりません。`,
        chartTrend: (k: Kind, m: string) => (k === 'house' ? `${m}の戸建ての土地1㎡あたりの価格の推移` : `${m}の土地の㎡単価の推移`),
        sourceTrend: (k: Kind, q: string) => (k === 'land' ? '出典：国土交通省 不動産情報ライブラリ（取引価格情報。登記をもとにしたアンケート調査）。' : '出典：国土交通省 不動産情報ライブラリ（成約価格情報）。') + `最新は${q}の分です。`,
        nextTrend: (k: Kind) => `<strong>${k === 'house' ? '戸建て' : '土地'}の価格は、本格査定でお出しします</strong><br />用途地域・路線価・接道の状況を当社が調べ、近くの成約事例と比べて価格を出します。費用はかかりません。`,
        chartFew: '四半期ごとの事例が少ないため、推移は表示できません。',
        message: (kind: string, place: string, spec: string, summary: string) => `【簡易査定】${kind}／${place}${spec ? `／${spec}` : ''}\n${summary}\n本格査定を希望します。`,
        spec: (b: string, fl: number, A: number, y: number) => `${b ? `${b}／` : ''}${fl ? `${fl}階／` : ''}専有${A}㎡／${y}年築`,
        summary: (mid: number, lo: number, hi: number, n: number) => `目安 ${fmt(mid)}万円（${fmt(lo)}〜${fmt(hi)}万円、事例${n}件）`,
        noSummary: { mansion: '目安は表示されませんでした', other: '戸建て・土地のため本格査定を希望' },
        period: (a: string, b: string) => `${a} 〜 ${b}`,
      };

  function quantile(a: number[], p: number) {
    const s = [...a].sort((x, y) => x - y);
    const i = (s.length - 1) * p;
    const lo = Math.floor(i);
    return s[lo] + (s[Math.ceil(i)] - s[lo]) * (i - lo);
  }
  const median = (a: number[]) => quantile(a, 0.5);
  const getJson = (path: string) => fetch(`/data/satei/${path}`).then((r) => r.json());

  const [meta, buildings, calib]: [Index, Building[], Calibration | null] = await Promise.all([
    getJson('index.json'),
    getJson('buildings.json'),
    getJson('calibration.json').catch(() => null),
  ]);
  const cache = new Map<string, unknown>();
  async function cached<T>(path: string): Promise<T> {
    if (!cache.has(path)) cache.set(path, await getJson(path));
    return cache.get(path) as T;
  }
  const kind = () => (document.querySelector<HTMLInputElement>('input[name="kind"]:checked')!.value as Kind);
  const findBuilding = () => buildings.find((b) => b.n === bldInput.value.trim());

  /** 表記ゆれ（全角半角・カナの大小・ケ/ヶ・中黒・空白）を吸収して比べる */
  const norm = (s: string) => s.normalize('NFKC').toLowerCase().replace(/[ヶヵ]/g, 'ケ').replace(/[\s・･\-ー,]/g, '');
  const muniOf = (code: string) => meta.munis.find((m) => m.code === code);
  /** 画面に出す市区町村名（英語版は英語表記） */
  const muniLabel = (code: string) => (EN ? muniOf(code)?.en : muniOf(code)?.name) ?? '';
  /** 画面に出す所在地（英語版は町名を出さない） */
  const placeLabel = (code: string, town: string) => (EN ? muniLabel(code) : `${muniLabel(code)}${town}`);
  const index = buildings.filter((b) => ENABLED(b.c)).map((b) => ({ b, name: norm(b.n), place: norm(`${muniOf(b.c)?.name ?? ''}${b.d}${muniOf(b.c)?.en ?? ''}`) }));

  /** 種類に合わせて入力欄と市区町村の一覧を切り替える */
  async function onKind() {
    const k = kind();
    document.querySelectorAll<HTMLElement>('[data-for]').forEach((el) => (el.hidden = !el.dataset.for!.split(' ').includes(k)));
    $('satei-submit').textContent = k === 'mansion' ? T.submit.mansion : T.submit.other;
    const prev = muniSel.value || '14133'; // 川崎市中原区
    muniSel.length = 0;
    for (const g of GROUPS) {
      const og = document.createElement('optgroup');
      og.label = T.group[g] ?? g;
      for (const m of meta.munis.filter((m) => m.group === g && ENABLED(m.code) && (m.counts[k] ?? 0) >= MIN_COMPS)) og.append(new Option(EN ? m.en : m.name, m.code));
      if (og.children.length) muniSel.append(og);
    }
    muniSel.value = prev;
    if (!muniSel.value) muniSel.selectedIndex = 0;
    $('satei-result').hidden = true;
    await onMuni();
  }
  /** 町名の一覧（マンションの事例がある町名）。戸建て・土地は町名を使わない */
  async function onMuni(district?: string) {
    distSel.length = 1;
    if (kind() !== 'mansion') return;
    const d = await cached<Data>(`mansion/${muniSel.value}.json`);
    d.districts.forEach((name, i) => distSel.append(new Option(name, String(i))));
    if (district) distSel.value = String(d.districts.indexOf(district));
  }
  document.querySelectorAll('input[name="kind"]').forEach((r) => r.addEventListener('change', onKind));
  muniSel.addEventListener('change', () => onMuni());
  /** マンション名を選んだら、市区町村・町名・築年を合わせる */
  async function applyBuilding() {
    const b = findBuilding();
    const hint = $('satei-building-hint');
    // タワーを選んだときだけ所在階の欄を出す
    const floorField = $('satei-floorno-field');
    const floorInput = $<HTMLInputElement>('satei-floorno');
    const tower = !!b && (b.f ?? 0) >= TOWER_FLOORS;
    floorField.hidden = !tower;
    if (tower) { floorInput.max = String(b!.f); floorInput.placeholder = `1〜${b!.f}`; } else floorInput.value = '';
    if (!b) {
      hint.textContent = bldInput.value.trim() ? T.notListed : T.hint;
      return;
    }
    muniSel.value = b.c;
    await onMuni(b.d);
    $<HTMLInputElement>('satei-built').value = String(b.y);
    hint.textContent = T.buildingHint(b);
  }

  // 候補リスト（ブラウザ標準の datalist はスマホや一部のブラウザで出ない・選んでも反映されないため自前で出す）
  $('satei-building-hint').textContent = T.hint;
  const listEl = $('satei-bld-list');
  let shown: Building[] = [];
  let active = -1;
  function openList() {
    const q = norm(bldInput.value);
    const here = muniSel.value;
    if (!q) {
      // 入力前は、選んでいる市区町村のマンションだけを出す
      shown = index.filter((x) => x.b.c === here).map((x) => x.b);
    } else {
      // 名前の先頭が一致 → 名前に含まれる → 区名・町名で一致の順。同じ順位なら、選んでいる市区町村 → 同じ都県 → 名前順
      const rank = (x: (typeof index)[number]) => (x.name.startsWith(q) ? 0 : x.name.includes(q) ? 1 : x.place.includes(q) ? 2 : -1);
      const near = (b: Building) => (b.c === here ? 0 : b.c.slice(0, 2) === here.slice(0, 2) ? 1 : 2);
      shown = index
        .map((x) => ({ x, r: rank(x) }))
        .filter(({ r }) => r >= 0)
        .sort((p, q2) => p.r - q2.r || near(p.x.b) - near(q2.x.b) || p.x.b.n.localeCompare(q2.x.b.n, 'ja'))
        .map(({ x }) => x.b);
    }
    shown = shown.slice(0, 40);
    active = -1;
    listEl.innerHTML = shown.length
      ? shown.map((b, i) => `<li role="option" id="bld-opt-${i}" data-i="${i}"><span>${b.n}</span><small>${placeLabel(b.c, b.d)}</small></li>`).join('')
      : `<li class="satei-combo-empty">${q ? T.emptyQuery : T.emptyHere(muniLabel(here))}</li>`;
    listEl.hidden = false;
    bldInput.setAttribute('aria-expanded', 'true');
  }
  function closeList() {
    listEl.hidden = true;
    bldInput.setAttribute('aria-expanded', 'false');
    bldInput.removeAttribute('aria-activedescendant');
  }
  function highlight(i: number) {
    active = i;
    listEl.querySelectorAll('li[role="option"]').forEach((li, j) => li.classList.toggle('active', j === i));
    const li = listEl.querySelector<HTMLElement>(`#bld-opt-${i}`);
    if (li) { li.scrollIntoView({ block: 'nearest' }); bldInput.setAttribute('aria-activedescendant', li.id); }
  }
  async function choose(i: number) {
    bldInput.value = shown[i].n;
    closeList();
    await applyBuilding();
  }
  bldInput.addEventListener('focus', openList);
  bldInput.addEventListener('input', () => { openList(); applyBuilding(); });
  bldInput.addEventListener('blur', () => setTimeout(closeList, 150));
  bldInput.addEventListener('keydown', (e) => {
    if (listEl.hidden && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) openList();
    if (e.key === 'ArrowDown') { e.preventDefault(); highlight(Math.min(active + 1, shown.length - 1)); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); highlight(Math.max(active - 1, 0)); }
    else if (e.key === 'Enter' && !listEl.hidden && active >= 0) { e.preventDefault(); choose(active); }
    else if (e.key === 'Escape') closeList();
  });
  // mousedown で選ぶ（click だと先に blur でリストが閉じる）
  listEl.addEventListener('mousedown', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('li[data-i]');
    if (!li) return;
    e.preventDefault();
    choose(Number(li.dataset.i));
  });
  await onKind();

  $('satei-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const k = kind();
    $('satei-result').hidden = false;
    if (k === 'mansion') await valueMansion();
    else await showTrend(k);
  });

  async function valueMansion() {
    const d = await cached<Data>(`mansion/${muniSel.value}.json`);
    const last = meta.last.mansion;
    const dist = !EN && distSel.value !== '' ? Number(distSel.value) : -1;
    const A = val('satei-area'), built = val('satei-built');
    const factor = (q: number) => d.idx[last] / d.idx[q];
    const unitOf = (x: number[]) => (x[2] * factor(x[0])) / x[3];
    const typedName = bldInput.value.trim();
    const b = findBuilding();
    const notes: string[] = [];
    const mName = muniLabel(d.code);

    let comps: number[][];
    let center: number;
    let spread: number[];
    let byBuilding = false;
    const recent = (x: number[]) => x[0] > last - RECENT;
    const like = (x: number[], y: number, at: number, bt: number) => recent(x) && Math.abs(x[3] - A) <= A * at && Math.abs(x[4] - y) <= bt;
    if (b && b.c === d.code) {
      // マンション名：同じ町・同じ築年の直近3年の事例。広さが近い事例が10件以上あればそれに絞る
      byBuilding = true;
      const di = d.districts.indexOf(b.d);
      const isOwn = (x: number[]) => x[1] === di && x[4] === b.y;
      const own = d.deals.filter((x) => isOwn(x) && recent(x));
      const ownNear = own.filter((x) => Math.abs(x[3] - A) <= A * 0.3);
      const ownUse = ownNear.length >= MIN_BUILDING ? ownNear : own;
      if (own.length >= MIN_BUILDING) {
        comps = ownUse;
        spread = comps.map(unitOf);
        center = median(spread);
        notes.push(T.ownSales(b, comps.length, ownUse === ownNear, A, `${d.name}${b.d}`));
      } else {
        // 事例が足りなければ、近くの築年・広さが近いマンションで補う（同じ町 → 市区町村全体の順に広げる）
        const others = (x: number[]) => !isOwn(x);
        let sim = d.deals.filter((x) => others(x) && x[1] === di && like(x, b.y, 0.3, 5));
        let where = T.sameTown(b);
        if (sim.length < MIN_BUILDING) { sim = d.deals.filter((x) => others(x) && like(x, b.y, 0.3, 5)); where = mName; }
        if (sim.length < MIN_BUILDING) { sim = d.deals.filter((x) => others(x) && like(x, b.y, 0.4, 8)); where = mName; }
        const simUnits = sim.map(unitOf);
        const ownUnits = ownUse.map(unitOf);
        const n = ownUnits.length;
        comps = [...ownUse, ...sim];
        spread = simUnits.length ? simUnits : ownUnits;
        center = simUnits.length ? (n ? (n * median(ownUnits) + K * median(simUnits)) / (n + K) : median(simUnits)) : n ? median(ownUnits) : 0;
        notes.push(T.fillSales(b, n, where, sim.length));
      }
      if (b.s.length) notes.push(T.shared(b.s));
      notes.push(T.privacy);
    } else {
      // 直近2年 → 直近3年 → 条件をゆるめる。3年より前の事例は使わない
      const match = (x: number[], q: number, at: number, bt: number) => x[0] > last - q && Math.abs(x[3] - A) <= A * at && Math.abs(x[4] - built) <= bt;
      let years = 2;
      comps = d.deals.filter((x) => match(x, 8, 0.25, 7));
      if (comps.length < WANT) { years = 3; comps = d.deals.filter((x) => match(x, RECENT, 0.25, 7)); }
      if (comps.length < WANT) comps = d.deals.filter((x) => match(x, RECENT, 0.35, 12));
      if (typedName && !b) notes.push(T.notListedCalc(typedName));
      notes.push(T.areaSales(mName, A, built));
      if (years === 3) notes.push(T.widened);
      // 町名の事例があれば、件数に応じて町名の中央値に寄せる（件数が少ないほど市区町村全体に近い）
      const units = comps.map(unitOf);
      const distUnits = dist >= 0 ? comps.filter((x) => x[1] === dist).map(unitOf) : [];
      const nd = distUnits.length;
      center = comps.length ? (nd ? (nd * median(distUnits) + K * median(units)) / (nd + K) : median(units)) : 0;
      spread = nd >= 8 ? distUnits : units;
      if (dist >= 0) notes.push(T.townWeighted(d.districts[dist], nd, mName));
    }

    $('r-price-block').hidden = false;
    $('r-next-text').innerHTML = T.nextMansion;
    const enough = comps.length >= MIN_COMPS;
    $('r-detail').hidden = !enough;
    if (!enough) {
      $('r-mid').textContent = '—';
      $('r-range').textContent = T.noEstimate;
      for (const id of ['r-unit', 'r-count', 'r-period']) $(id).textContent = '';
      $('r-note').textContent = '';
      prefill('mansion', placeLabel(d.code, dist >= 0 ? d.districts[dist] : ''), '');
      return;
    }
    // 最近の成約の水準に合わせる補正と、タワーの所在階の補正
    const tower = byBuilding && (b!.f ?? 0) >= TOWER_FLOORS;
    const calFactor = calib ? (tower ? calib.tower : byBuilding ? calib.building : calib.general) : 1;
    const floorNo = tower ? val('satei-floorno') : 0;
    const floorAdj = calib && tower && floorNo >= 1 ? 1 + calib.floor_slope * (Math.min(floorNo / b!.f!, 1) - 0.5) : 1;
    center *= calFactor * floorAdj;
    if (calib) notes.push(T.calib(calFactor, calib.asof));
    if (floorAdj !== 1) notes.push(T.floorAdj(floorNo, b!.f!, floorAdj));
    else if (tower) notes.push(T.floorTip(calib!.floor_slope));
    const shift = center / median(spread);
    const mid = round10(center * A);
    const lo = round10(quantile(spread, 0.25) * shift * A);
    const hi = round10(quantile(spread, 0.75) * shift * A);
    const minQ = Math.min(...comps.map((x) => x[0]));

    $('r-label').textContent = T.label(byBuilding ? b : undefined);
    $('r-mid').innerHTML = EN ? yen(mid) : `${fmt(mid)}<small>万円</small>`;
    $('r-range').textContent = `${yen(lo)} ${EN ? '–' : '〜'} ${yen(hi)}`;
    $('r-unit').textContent = unitYen(center);
    $('r-count').textContent = T.count(comps.length);
    $('r-period').textContent = T.period(qLabel(meta.quarters[minQ]), qLabel(meta.quarters[last]));
    $('r-note').textContent = notes.join('');

    $('r-table-block').hidden = byBuilding;
    if (!byBuilding) {
      const score = (x: number[]) => (x[1] === dist ? -1 : 0) + Math.abs(x[3] - A) / A + Math.abs(x[4] - built) / 20 + (last - x[0]) / 40;
      const near = [...comps].sort((p, q) => score(p) - score(q)).slice(0, 8);
      $('r-rows').innerHTML = near
        .map((x) => `<tr><td>${qLabel(meta.quarters[x[0]])}</td><td>${d.districts[x[1]] ?? '—'}</td><td>${x[3]}㎡</td><td>${EN ? x[4] : `${x[4]}年`}</td><td>${yen(x[2])}</td><td>${unitYen(unitOf(x))}</td></tr>`)
        .join('');
    }
    const by: number[][] = meta.quarters.map(() => []);
    for (const x of d.deals) by[x[0]].push(x[2] / x[3]);
    drawChart(T.chartMansion(mName), by.map((a) => (a.length >= 5 ? median(a) : null)).slice(0, last + 1));
    $('r-source').textContent = T.source(qLabel(meta.quarters[last]));
    prefill('mansion', placeLabel(d.code, dist >= 0 ? d.districts[dist] : b?.d ?? ''), T.summary(mid, lo, hi, comps.length));
  }

  /** 戸建て・土地：価格は出さず、市区町村の土地1㎡あたりの推移だけ見せる */
  async function showTrend(k: Kind) {
    const series = (await cached<Record<string, (number | null)[]>>(`trend_${k}.json`))[muniSel.value] ?? [];
    const name = muniLabel(muniSel.value);
    $('r-price-block').hidden = true;
    $('r-table-block').hidden = true;
    $('r-detail').hidden = false;
    $('r-note').textContent = T.trendNote(k);
    drawChart(T.chartTrend(k, name), series.slice(0, meta.last[k] + 1));
    $('r-source').textContent = T.sourceTrend(k, qLabel(meta.quarters[meta.last[k]]));
    $('r-next-text').innerHTML = T.nextTrend(k);
    prefill(k, name, '');
  }

  function drawChart(title: string, vals: (number | null)[]) {
    $('r-chart-title').textContent = title;
    const ok = vals.filter((v): v is number => v !== null);
    if (ok.length < 2) { $('r-chart').innerHTML = `<p class="satei-note">${T.chartFew}</p>`; return; }
    const W = 640, H = 200, P = 40;
    const hiV = Math.max(...ok);
    const s = hiV > 200 ? 50 : hiV > 50 ? 10 : 5;
    const min = Math.floor(Math.min(...ok) / s) * s, max = Math.ceil(hiV / s) * s;
    const x = (i: number) => P + ((W - P * 1.5) * i) / (meta.quarters.length - 1);
    const y = (v: number) => H - 24 - ((H - 40) * (v - min)) / (max - min || 1);
    const pts = vals.map((v, i) => (v === null ? null : `${x(i)},${y(v)}`)).filter(Boolean).join(' ');
    const years = meta.quarters.map((q, i) => (q.endsWith('Q1') ? `<text x="${x(i)}" y="${H - 6}" text-anchor="middle">${q.slice(0, 4)}</text><line x1="${x(i)}" x2="${x(i)}" y1="${y(max)}" y2="${H - 24}" class="grid"/>` : '')).join('');
    $('r-chart').innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${title}">
      ${years}
      <text x="${P - 6}" y="${y(max) + 4}" text-anchor="end">${max}</text>
      <text x="${P - 6}" y="${y(min) + 4}" text-anchor="end">${min}</text>
      <polyline points="${pts}" class="line"/>
      <text x="${W - 6}" y="12" text-anchor="end">${T.chartUnit}</text>
    </svg>`;
  }

  function prefill(k: Kind, place: string, summary: string) {
    const form = document.querySelector('.contact-form');
    if (!form) return;
    const set = (name: string, v: string) => {
      const el = form.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${name}"]`);
      if (el) el.value = v;
    };
    set('property_type', k);
    set('location', place);
    const bname = k === 'mansion' ? bldInput.value.trim() : '';
    if (bname) set('building_name', bname);
    const floorNo = k === 'mansion' ? val('satei-floorno') : 0;
    const spec = k === 'mansion' ? T.spec(bname, floorNo, val('satei-area'), val('satei-built')) : '';
    set('message', T.message(T.kind[k], place, spec, summary || (k === 'mansion' ? T.noSummary.mansion : T.noSummary.other)));
  }
</script>


